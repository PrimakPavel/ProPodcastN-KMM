<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Downloaded episodes can be downloaded again and would exceed the 25 MB backup quota. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="episodes/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="episodes/" />
    </device-transfer>
</data-extraction-rules>
